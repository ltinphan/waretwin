[Unit]
Description=WareTwin auto-deploy webhook (HTTP -> git pull + rebuild)
After=network.target docker.service
Wants=docker.service

[Service]
EnvironmentFile=/etc/waretwin-deploy.env
ExecStart=/usr/bin/python3 /root/.hermes/shared/waretwin/scripts/webhook-deploy.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
